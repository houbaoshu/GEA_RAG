# GEA Multimodal Product Intelligence Agent Environment Configuration

# 1. API 鉴权密钥 (FastAPI Bearer Authentication)
GEA_API_KEY=gea-industrial-secret-key

# 2. Qwen-VL 模型后端选择: "local" (本地 PyTorch 推理) 或 "api" (阿里云 DashScope)
QWEN_VL_BACKEND=api

# 3. 阿里云 DashScope / 通义千问 API 密钥 (当 QWEN_VL_BACKEND=api 时生效)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 4. 可选: OpenAI / Qwen 兼容接口密钥
# OPENAI_API_KEY=your_openai_api_key_here
